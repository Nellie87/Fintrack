# Copy to .env and fill in. Never commit .env.

# Postgres (Neon): pooled connection for the app, direct connection for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"

# JWT signing secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# Exact frontend origin allowed by CORS (no trailing slash)
CORS_ORIGIN="http://localhost:5173"
